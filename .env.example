# Copy this file to ".env" in the same directory and fill in the absolute
# paths for your machine. Node's --env-file-if-exists flag reads it on
# server startup; values appear in process.env. The .env file itself is
# gitignored so each developer keeps their own paths.

# Folder Tarkov writes F12-overlay screenshots into. To find it: take a
# screenshot in-raid with F12, then locate the .png file on disk.
# Typical Windows locations:
#   %USERPROFILE%\Documents\Escape from Tarkov\Screenshots
#   %OneDrive%\Documents\Escape from Tarkov\Screenshots
TARKOV_SCREENSHOT_DIR=

# Folder Tarkov writes raid logs into.
# Typical Windows location:
#   %LOCALAPPDATA%\Battlestate Games\EscapeFromTarkov\Logs
TARKOV_LOG_DIR=
