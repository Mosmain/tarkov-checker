{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "tarkov-checker",
  "identifier": "dev.tarkov-checker.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @tarkov-checker/client dev",
    "beforeBuildCommand": "pnpm --filter @tarkov-checker/client build"
  },
  "app": {
    "windows": [
      {
        "title": "tarkov-checker",
        "label": "main",
        "width": 360,
        "height": 360,
        "minWidth": 200,
        "minHeight": 200,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "alwaysOnTop": false,
        "transparent": true,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-http-cache"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
