{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "HOST",
        "TARKOV_LOG_DIR",
        "TARKOV_SCREENSHOT_DIR",
        "LOCALAPPDATA",
        "USERPROFILE",
        "OneDrive",
        "HOME"
      ]
    }
  }
}
