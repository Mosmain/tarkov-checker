{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "tarkov-checker",
  "version": "0.0.0",
  "identifier": "dev.tarkov-checker.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm --filter @tarkov-checker/client build"
  },
  "app": {
    "windows": [
      {
        "title": "tarkov-checker",
        "label": "main",
        "width": 800,
        "height": 600,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
